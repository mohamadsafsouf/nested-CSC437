{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camguard.local/schemas/camera-security-event.schema.json",
  "title": "CamGuard Camera Security Event",
  "description": "Shared metadata-only event contract for macOS, iPhone, backend scoring, Supabase storage, and dashboard tracking.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "platform",
    "occurred_at",
    "collected_at",
    "device",
    "application",
    "camera",
    "permission",
    "risk_context",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "camera_session",
        "permission_change",
        "network_activity",
        "simulation"
      ]
    },
    "platform": {
      "type": "string",
      "enum": [
        "macos",
        "ios"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_device_id",
        "display_name",
        "os_name",
        "os_version"
      ],
      "properties": {
        "client_device_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable local identifier generated by the client before Supabase device registration."
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "os_name": {
          "type": "string",
          "enum": [
            "macOS",
            "iOS"
          ]
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "bundle_identifier",
        "process_id",
        "is_trusted",
        "is_known"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "bundle_identifier": {
          "type": [
            "string",
            "null"
          ],
          "description": "May be null when macOS process metadata is unavailable or for iOS in-app events before bundle mapping."
        },
        "process_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "signing_team_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_website_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Browser tab URL when camera activity is attributed to a website. Metadata only; no page content or media."
        },
        "observed_website_host": {
          "type": [
            "string",
            "null"
          ],
          "description": "Normalized website host used for same-source camera risk correlation."
        },
        "is_trusted": {
          "type": "boolean"
        },
        "is_known": {
          "type": "boolean"
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "session_id",
        "duration_seconds",
        "activation_count_recent_window",
        "is_background_access",
        "is_repeated_short_activation"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "started",
            "ended",
            "active",
            "permission_only",
            "unknown"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "activation_count_recent_window": {
          "type": "integer",
          "minimum": 0
        },
        "recent_window_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 600
        },
        "is_background_access": {
          "type": "boolean",
          "description": "On iOS this must only describe CamGuard's own app session context, not other apps."
        },
        "is_repeated_short_activation": {
          "type": "boolean"
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_status",
        "changed_recently"
      ],
      "properties": {
        "camera_status": {
          "type": "string",
          "enum": [
            "authorized",
            "denied",
            "restricted",
            "not_determined",
            "unknown"
          ]
        },
        "previous_camera_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "authorized",
            "denied",
            "restricted",
            "not_determined",
            "unknown",
            null
          ]
        },
        "changed_recently": {
          "type": "boolean"
        }
      }
    },
    "risk_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_upload_after_camera",
        "network_window_seconds",
        "is_simulated",
        "simulation_label"
      ],
      "properties": {
        "network_upload_after_camera": {
          "type": "boolean"
        },
        "network_window_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "remote_endpoint": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "Optional remote endpoint metadata for defensive correlation. Location fields describe the remote endpoint, not the user's physical location.",
          "properties": {
            "destination_ip": {
              "type": [
                "string",
                "null"
              ],
              "format": "ipv4"
            },
            "destination_hostname": {
              "type": [
                "string",
                "null"
              ]
            },
            "destination_port": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 65535
            },
            "protocol": {
              "type": "string",
              "enum": [
                "tcp",
                "udp",
                "quic",
                "icmp",
                "unknown"
              ]
            },
            "asn": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "organization": {
              "type": [
                "string",
                "null"
              ]
            },
            "country_code": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z]{2}$"
            },
            "region": {
              "type": [
                "string",
                "null"
              ]
            },
            "city": {
              "type": [
                "string",
                "null"
              ]
            },
            "is_vpn_or_proxy": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "is_tor_exit_node": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reputation_score": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "reputation_source": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "is_simulated": {
          "type": "boolean"
        },
        "simulation_label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Required by product policy when is_simulated is true."
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "scoring": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "anomaly_score",
        "contextual_score",
        "threat_probability",
        "threat_level"
      ],
      "properties": {
        "anomaly_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "contextual_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "threat_probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "threat_level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "normal",
            "suspicious",
            "critical",
            null
          ]
        }
      },
      "description": "Clients may send null or provisional values; backend scoring remains authoritative."
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_media",
        "media_upload_attempted",
        "user_visible_disclosure"
      ],
      "properties": {
        "contains_media": {
          "type": "boolean",
          "const": false
        },
        "media_upload_attempted": {
          "type": "boolean",
          "const": false
        },
        "user_visible_disclosure": {
          "type": "boolean",
          "description": "True when the app has shown users what camera/security metadata is collected."
        }
      }
    }
  }
}
